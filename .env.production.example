# Production-like test deployment overrides for docker-compose.
# Copy this file to .env.production only when you want to override the built-in
# test defaults in config/settings.py. Replace every placeholder before using
# this stack for anything beyond local testing.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_BEHIND_PROXY=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_COOKIES=false
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# Access JWT (HS256)
AUTH_JWT_SECRET=replace-with-a-different-long-random-secret
AUTH_JWT_ISSUER=http://localhost:8000
AUTH_JWT_AUDIENCE=http://localhost:3000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS (resource routes only; /auth/* is excluded)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_ENGINE=postgresql
DB_NAME=persu
DB_USER=persu
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Shared cache for throttling across Gunicorn workers
REDIS_URL=redis://redis:6379/1

# Docker Compose / Gunicorn
WEB_PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
