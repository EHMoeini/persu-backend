# Optional local development overrides.
# The application already has production-like test defaults in config/settings.py.
# These variables are not loaded automatically; export them in your shell.
# Never commit real secrets. For a deployment template, see
# .env.production.example.

# Django
DJANGO_DEBUG=true
# Use at least 32 random characters for any shared deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_BEHIND_PROXY=false
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_SECURE_COOKIES=false
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Access JWT (HS256). Use at least 32 random characters for any shared deployment.
AUTH_JWT_SECRET=replace-with-a-separate-long-random-value
AUTH_JWT_ISSUER=http://localhost:8000
AUTH_JWT_AUDIENCE=http://localhost:3000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS (resource routes only; /auth/* is excluded)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (SQLite is the default; set DB_ENGINE=postgresql for PostgreSQL)
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3
# DB_NAME=persu
# DB_USER=persu
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Shared cache. Leave unset for local memory; set Redis in production.
# REDIS_URL=redis://127.0.0.1:6379/1

# Logging
DJANGO_LOG_LEVEL=INFO
