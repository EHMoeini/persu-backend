# Local development environment variables.
# Not loaded automatically; export these in your shell. Never commit secrets.
# For a production-like test deployment, see .env.production.example.

# Django
DJANGO_DEBUG=true
# Use at least 32 random characters in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_BEHIND_PROXY=false
# DJANGO_SECURE_HSTS_SECONDS=0
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# Access JWT (HS256). Use at least 32 random characters in production.
AUTH_JWT_SECRET=replace-with-a-separate-long-random-value
AUTH_JWT_ISSUER=https://api.example.com
AUTH_JWT_AUDIENCE=https://app.example.com
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# CORS (resource routes only; /auth/* is excluded)
CORS_ALLOWED_ORIGINS=https://app.example.com

# Database (SQLite is the default; set DB_ENGINE=postgresql for PostgreSQL)
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3
# DB_NAME=persu
# DB_USER=persu
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Shared cache. Leave unset for local memory; set Redis in production.
# REDIS_URL=redis://127.0.0.1:6379/1

# Logging
DJANGO_LOG_LEVEL=INFO
